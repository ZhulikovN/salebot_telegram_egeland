[Unit]
Description=Salebot ↔ amoCRM Integration API (egeland)
After=network.target

[Service]
User=deploy
Group=deploy

EnvironmentFile=/home/deploy/salebot_telegram_egeland/current/.env

WorkingDirectory=/home/deploy/salebot_telegram_egeland/current

ExecStart=/home/deploy/salebot_telegram_egeland/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8024 --workers 2

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
