[Unit]
Description=Salebot ↔ amoCRM UTM Backfill Worker (egeland)
After=network.target

[Service]
User=deploy
Group=deploy

EnvironmentFile=/home/deploy/salebot_telegram_egeland/current/.env

WorkingDirectory=/home/deploy/salebot_telegram_egeland/current

ExecStart=/home/deploy/salebot_telegram_egeland/current/.venv/bin/python -m app.workers.utm_backfill_worker

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
