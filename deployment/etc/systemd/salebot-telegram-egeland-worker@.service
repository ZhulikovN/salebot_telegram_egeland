[Unit]
Description=Salebot ↔ amoCRM Worker %i (egeland)
After=network.target

[Service]
User=deploy
Group=deploy

EnvironmentFile=/home/deploy/salebot_telegram_egeland/current/.env

WorkingDirectory=/home/deploy/salebot_telegram_egeland/current

ExecStart=/home/deploy/salebot_telegram_egeland/current/.venv/bin/python -m app.workers.worker

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
