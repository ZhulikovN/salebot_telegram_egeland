# amoCRM
AMOCRM_SUBDOMAIN=your_subdomain
AMO_ACCESS_TOKEN=your_long_lived_token

# amoCRM OAuth2
AMO_CLIENT_ID=your_client_id
AMO_CLIENT_SECRET=your_client_secret
AMO_REDIRECT_URI=https://your_subdomain.amocrm.ru/
AMO_AUTH_CODE=your_auth_code
BASE_DOMAIN=your_subdomain.amocrm.ru

# amojo (канал для чатов)
AMOJO_CHANNEL_ID=your_channel_id
AMOJO_CHANNEL_SECRET=your_channel_secret
AMOJO_SCOPE_ID=your_scope_id
AMOJO_ACCOUNT_ID=your_account_id

# Salebot (проект 799515)
SALEBOT_API_KEY=your_salebot_api_key
SALEBOT_PROJECT_ID=799515

# Токены Telegram-ботов для прямой отправки медиа (JSON: bot_name → token).
# Для перечисленных ботов вложения грузятся в Telegram байтами, а не ссылкой.
# Боты без токена работают по-старому — через Salebot.
TELEGRAM_BOT_TOKENS={"el_connetbot": "123456789:AA..."}

# Воронка и этап
AMOCRM_PIPELINE_ID=10195498
AMOCRM_STATUS_ID=80731234
STATUS_SUCCESS=142а
STATUS_CLOSED=143

# ID полей контакта в AMO (Radist.online)
FIELD_TG_ID=811310
FIELD_TG_USERNAME=811308

# ID полей сделки в AMO
FIELD_BOT_NAME=809165

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=salebot_egeland
POSTGRES_USER=salebot
POSTGRES_PASSWORD=your_postgres_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password

# Rate Limiting
AMOCRM_MAX_REQUESTS_PER_SECOND=7
