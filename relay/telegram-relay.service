[Unit]
Description=Telegram Relay Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/relay
EnvironmentFile=/home/ubuntu/relay/.env
ExecStart=/home/ubuntu/relay/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
